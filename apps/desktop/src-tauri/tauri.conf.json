{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Globe Shift",
  "version": "0.1.0",
  "identifier": "dev.globeshift.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Globe Shift",
        "width": 1200,
        "height": 780
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "targets": "all"
  }
}
